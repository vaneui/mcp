{
  "name": "@vaneui/mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server that exposes VaneUI component documentation as resources for MCP-aware clients.",
  "license": "MIT",
  "author": "VaneUI",
  "homepage": "https://github.com/vaneui/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaneui/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/vaneui/mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "modelcontextprotocol",
    "vaneui",
    "react",
    "tailwind",
    "tailwindcss",
    "components",
    "documentation",
    "ai",
    "llm",
    "claude",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "vaneui-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "resources",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs && node scripts/sync-component-props.mjs",
    "sync:strict": "node scripts/sync-docs.mjs --strict && node scripts/sync-component-props.mjs --strict",
    "build": "tsc",
    "build:full": "npm run sync && tsc",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run sync:strict && tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.2"
  }
}
