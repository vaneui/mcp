{
  "name": "@vaneui/mcp",
  "version": "1.2.0",
  "mcpName": "io.github.vaneui/mcp",
  "description": "Model Context Protocol server that exposes VaneUI component documentation as resources for MCP-aware clients.",
  "license": "MIT",
  "author": "VaneUI",
  "homepage": "https://github.com/vaneui/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaneui/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/vaneui/mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "vaneui",
    "react",
    "tailwind",
    "tailwindcss",
    "components",
    "documentation",
    "ai",
    "llm",
    "claude",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "vaneui-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "resources",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.ts && node scripts/sync-component-props.ts",
    "sync:strict": "node scripts/sync-docs.ts --strict && node scripts/sync-component-props.ts --strict",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "npm run build && npm run typecheck && node --test test/*.test.ts",
    "build:full": "npm run sync && npm run build",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run sync:strict && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.2"
  }
}
